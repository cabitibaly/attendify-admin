{
  "expo": {
    "name": "administrateur",
    "slug": "administrateur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Icon_adm_1024.png",
    "scheme": "administrateur",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A132C",
        "foregroundImage": "./assets/images/Icon_adm_1024.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bcalex.attentify_admin",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/attendify-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A132C"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f291ccf8-150c-47e3-911f-1d9232f5b28d"
      }
    }
  }
}
